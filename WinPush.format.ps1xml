<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>WinPush.ExecutionResult.RunCommand.Status</Name>
      <ViewSelectedBy>
        <TypeName>WinPush.ExecutionResult.RunCommand</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>ComputerName</Label></TableColumnHeader>
          <TableColumnHeader><Label>Transport</Label></TableColumnHeader>
          <TableColumnHeader><Label>Status</Label></TableColumnHeader>
          <TableColumnHeader><Label>ExitCode</Label></TableColumnHeader>
          <TableColumnHeader><Label>OutputSummary</Label></TableColumnHeader>
          <TableColumnHeader><Label>ErrorSummary</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>ComputerName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Transport</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.Succeeded) { 'OK' } else { 'Failed' }</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>ExitCode</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>$summary = $null; foreach ($item in @($_.Output)) { if ($null -eq $item) { continue }; if (($item -isnot [string]) -and ($item -isnot [ValueType])) { continue }; $candidate = ([string] $item) -replace '\s+', ' '; $candidate = $candidate.Trim(); if (-not [string]::IsNullOrWhiteSpace($candidate)) { $summary = $candidate; break } }; if (-not [string]::IsNullOrWhiteSpace($summary)) { if ($summary.Length -gt 72) { $summary.Substring(0, 69) + '...' } else { $summary } }</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>if (-not $_.Succeeded) { $message = if (-not [string]::IsNullOrWhiteSpace($_.ErrorMessage)) { [string] $_.ErrorMessage } elseif (@($_.Errors).Count -gt 0) { [string] @($_.Errors)[0] } else { $null }; if (-not [string]::IsNullOrWhiteSpace($message)) { $summary = $message -replace '\s+', ' '; if ($summary -match '(?i)we can''t sign you in with this credential because your domain isn''t available|errorcode 0x80090311|kerberos authentication') { 'WinRM Kerberos authentication failed' } elseif ($summary -match '(?i)server name cannot be resolved') { 'Server name cannot be resolved' } elseif ($summary -match '(?i)client cannot connect to the destination') { 'Client cannot connect to destination' } elseif ($summary -match '(?i)WinRM cannot complete the operation') { 'WinRM connection failed' } elseif ($summary -match '(?i)access is denied|access denied') { 'Access denied' } elseif ($summary -match '(?i)couldn''t access .+:') { 'PsExec cannot access target' } elseif ($summary -match '(?i)timed out|timeout') { 'Connection timed out' } elseif ($summary.Length -gt 72) { $summary.Substring(0, 69) + '...' } else { $summary } } }</ScriptBlock></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>WinPush.ExecutionResult.RunScript.Status</Name>
      <ViewSelectedBy>
        <TypeName>WinPush.ExecutionResult.RunScript</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>ComputerName</Label></TableColumnHeader>
          <TableColumnHeader><Label>Transport</Label></TableColumnHeader>
          <TableColumnHeader><Label>Status</Label></TableColumnHeader>
          <TableColumnHeader><Label>ExitCode</Label></TableColumnHeader>
          <TableColumnHeader><Label>Script</Label></TableColumnHeader>
          <TableColumnHeader><Label>ErrorSummary</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>ComputerName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Transport</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.Succeeded) { 'OK' } else { 'Failed' }</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>ExitCode</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Script</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>if (-not $_.Succeeded) { $message = if (-not [string]::IsNullOrWhiteSpace($_.ErrorMessage)) { [string] $_.ErrorMessage } elseif (@($_.Errors).Count -gt 0) { [string] @($_.Errors)[0] } else { $null }; if (-not [string]::IsNullOrWhiteSpace($message)) { $summary = $message -replace '\s+', ' '; if ($summary -match '(?i)we can''t sign you in with this credential because your domain isn''t available|errorcode 0x80090311|kerberos authentication') { 'WinRM Kerberos authentication failed' } elseif ($summary -match '(?i)server name cannot be resolved') { 'Server name cannot be resolved' } elseif ($summary -match '(?i)client cannot connect to the destination') { 'Client cannot connect to destination' } elseif ($summary -match '(?i)WinRM cannot complete the operation') { 'WinRM connection failed' } elseif ($summary -match '(?i)access is denied|access denied') { 'Access denied' } elseif ($summary -match '(?i)couldn''t access .+:') { 'PsExec cannot access target' } elseif ($summary -match '(?i)timed out|timeout') { 'Connection timed out' } elseif ($summary.Length -gt 72) { $summary.Substring(0, 69) + '...' } else { $summary } } }</ScriptBlock></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>WinPush.ExecutionResult.RunPackage.Status</Name>
      <ViewSelectedBy>
        <TypeName>WinPush.ExecutionResult.RunPackage</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>ComputerName</Label></TableColumnHeader>
          <TableColumnHeader><Label>Transport</Label></TableColumnHeader>
          <TableColumnHeader><Label>Status</Label></TableColumnHeader>
          <TableColumnHeader><Label>ExitCode</Label></TableColumnHeader>
          <TableColumnHeader><Label>Package</Label></TableColumnHeader>
          <TableColumnHeader><Label>Cleanup</Label></TableColumnHeader>
          <TableColumnHeader><Label>Logs</Label></TableColumnHeader>
          <TableColumnHeader><Label>ErrorSummary</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>ComputerName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Transport</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.Succeeded) { 'OK' } else { 'Failed' }</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>ExitCode</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>$metadata = $_.PackageMetadata; if ($null -ne $metadata) { $package = if (-not [string]::IsNullOrWhiteSpace($metadata.PackageSource)) { [System.IO.Path]::GetFileName(([string] $metadata.PackageSource).TrimEnd('\', '/')) }; if ([string]::IsNullOrWhiteSpace($package)) { [string] $metadata.PackageSource } else { $package } }</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>$metadata = $_.PackageMetadata; if ($null -ne $metadata) { if ($metadata.CleanupPolicy -eq 'Never') { 'Retained' } elseif ($metadata.CleanupSucceeded -eq $true) { 'Removed' } elseif ($metadata.CleanupSucceeded -eq $false) { 'Failed' } }</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>$metadata = $_.PackageMetadata; if ($null -ne $metadata) { if ($metadata.LogsCopied -eq $true -or @($metadata.CopiedLogPaths).Count -gt 0 -or @($_.CopiedLogPaths).Count -gt 0) { 'Yes' } else { 'No' } } elseif (@($_.CopiedLogPaths).Count -gt 0 -or @($_.Logs).Count -gt 0) { 'Yes' } else { 'No' }</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>if (-not $_.Succeeded) { $message = if (-not [string]::IsNullOrWhiteSpace($_.ErrorMessage)) { [string] $_.ErrorMessage } elseif (@($_.Errors).Count -gt 0) { [string] @($_.Errors)[0] } else { $null }; if (-not [string]::IsNullOrWhiteSpace($message)) { $summary = $message -replace '\s+', ' '; if ($summary -match '(?i)we can''t sign you in with this credential because your domain isn''t available|errorcode 0x80090311|kerberos authentication') { 'WinRM Kerberos authentication failed' } elseif ($summary -match '(?i)server name cannot be resolved') { 'Server name cannot be resolved' } elseif ($summary -match '(?i)client cannot connect to the destination') { 'Client cannot connect to destination' } elseif ($summary -match '(?i)WinRM cannot complete the operation') { 'WinRM connection failed' } elseif ($summary -match '(?i)access is denied|access denied') { 'Access denied' } elseif ($summary -match '(?i)couldn''t access .+:') { 'PsExec cannot access target' } elseif ($summary -match '(?i)timed out|timeout') { 'Connection timed out' } elseif ($summary.Length -gt 72) { $summary.Substring(0, 69) + '...' } else { $summary } } }</ScriptBlock></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>WinPush.ExecutionResult.CopyFile.Status</Name>
      <ViewSelectedBy>
        <TypeName>WinPush.ExecutionResult.CopyFile</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>ComputerName</Label></TableColumnHeader>
          <TableColumnHeader><Label>Transport</Label></TableColumnHeader>
          <TableColumnHeader><Label>Status</Label></TableColumnHeader>
          <TableColumnHeader><Label>Source</Label></TableColumnHeader>
          <TableColumnHeader><Label>Destination</Label></TableColumnHeader>
          <TableColumnHeader><Label>ErrorSummary</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>ComputerName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Transport</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.Succeeded) { 'OK' } else { 'Failed' }</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>$copy = @($_.Output)[0]; if ($null -ne $copy -and $copy.PSObject.Properties['Source']) { [string] $copy.Source }</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>$copy = @($_.Output)[0]; if ($null -ne $copy -and $copy.PSObject.Properties['Destination']) { [string] $copy.Destination }</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>if (-not $_.Succeeded) { $message = if (-not [string]::IsNullOrWhiteSpace($_.ErrorMessage)) { [string] $_.ErrorMessage } elseif (@($_.Errors).Count -gt 0) { [string] @($_.Errors)[0] } else { $null }; if (-not [string]::IsNullOrWhiteSpace($message)) { $summary = $message -replace '\s+', ' '; if ($summary -match '(?i)we can''t sign you in with this credential because your domain isn''t available|errorcode 0x80090311|kerberos authentication') { 'WinRM Kerberos authentication failed' } elseif ($summary -match '(?i)server name cannot be resolved') { 'Server name cannot be resolved' } elseif ($summary -match '(?i)client cannot connect to the destination') { 'Client cannot connect to destination' } elseif ($summary -match '(?i)WinRM cannot complete the operation') { 'WinRM connection failed' } elseif ($summary -match '(?i)access is denied|access denied') { 'Access denied' } elseif ($summary -match '(?i)couldn''t access .+:') { 'PsExec cannot access target' } elseif ($summary -match '(?i)timed out|timeout') { 'Connection timed out' } elseif ($summary.Length -gt 72) { $summary.Substring(0, 69) + '...' } else { $summary } } }</ScriptBlock></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>WinPush.ExecutionResult.GetLogs.Status</Name>
      <ViewSelectedBy>
        <TypeName>WinPush.ExecutionResult.GetLogs</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>ComputerName</Label></TableColumnHeader>
          <TableColumnHeader><Label>Transport</Label></TableColumnHeader>
          <TableColumnHeader><Label>Status</Label></TableColumnHeader>
          <TableColumnHeader><Label>LogPath</Label></TableColumnHeader>
          <TableColumnHeader><Label>Files</Label></TableColumnHeader>
          <TableColumnHeader><Label>Destination</Label></TableColumnHeader>
          <TableColumnHeader><Label>ErrorSummary</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>ComputerName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Transport</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.Succeeded) { 'OK' } else { 'Failed' }</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>$file = @($_.Output)[0]; $log = @($_.Logs)[0]; if ($null -ne $file -and $file.PSObject.Properties['RemoteDirectory']) { [string] $file.RemoteDirectory } elseif ($null -ne $log -and $log.PSObject.Properties['RemotePath']) { Split-Path -Path ([string] $log.RemotePath) -Parent }</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>$files = @($_.Output).Count; if ($files -eq 0) { $files = @($_.Logs).Count }; if ($files -eq 0) { $files = @($_.CopiedLogPaths).Count }; $files</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>$path = @($_.CopiedLogPaths)[0]; if (-not [string]::IsNullOrWhiteSpace($path)) { Split-Path -Path ([string] $path) -Parent } elseif (-not [string]::IsNullOrWhiteSpace($_.ComputerDirectory)) { $_.ComputerDirectory }</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>if (-not $_.Succeeded) { $message = if (-not [string]::IsNullOrWhiteSpace($_.ErrorMessage)) { [string] $_.ErrorMessage } elseif (@($_.Errors).Count -gt 0) { [string] @($_.Errors)[0] } else { $null }; if (-not [string]::IsNullOrWhiteSpace($message)) { $summary = $message -replace '\s+', ' '; if ($summary -match '(?i)we can''t sign you in with this credential because your domain isn''t available|errorcode 0x80090311|kerberos authentication') { 'WinRM Kerberos authentication failed' } elseif ($summary -match '(?i)server name cannot be resolved') { 'Server name cannot be resolved' } elseif ($summary -match '(?i)client cannot connect to the destination') { 'Client cannot connect to destination' } elseif ($summary -match '(?i)WinRM cannot complete the operation') { 'WinRM connection failed' } elseif ($summary -match '(?i)access is denied|access denied') { 'Access denied' } elseif ($summary -match '(?i)couldn''t access .+:') { 'PsExec cannot access target' } elseif ($summary -match '(?i)timed out|timeout') { 'Connection timed out' } elseif ($summary.Length -gt 72) { $summary.Substring(0, 69) + '...' } else { $summary } } }</ScriptBlock></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>WinPush.ExecutionResult.TestTarget.Status</Name>
      <ViewSelectedBy>
        <TypeName>WinPush.ExecutionResult.TestTarget</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>ComputerName</Label></TableColumnHeader>
          <TableColumnHeader><Label>Reachable</Label></TableColumnHeader>
          <TableColumnHeader><Label>Transport</Label></TableColumnHeader>
          <TableColumnHeader><Label>ErrorSummary</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>ComputerName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Succeeded</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Transport</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>if (-not $_.Succeeded) { $message = if (-not [string]::IsNullOrWhiteSpace($_.ErrorMessage)) { [string] $_.ErrorMessage } elseif (@($_.Errors).Count -gt 0) { [string] @($_.Errors)[0] } else { $null }; if (-not [string]::IsNullOrWhiteSpace($message)) { $summary = $message -replace '\s+', ' '; if ($summary -match '(?i)we can''t sign you in with this credential because your domain isn''t available|errorcode 0x80090311|kerberos authentication') { 'WinRM Kerberos authentication failed' } elseif ($summary -match '(?i)server name cannot be resolved') { 'Server name cannot be resolved' } elseif ($summary -match '(?i)client cannot connect to the destination') { 'Client cannot connect to destination' } elseif ($summary -match '(?i)WinRM cannot complete the operation') { 'WinRM connection failed' } elseif ($summary -match '(?i)access is denied|access denied') { 'Access denied' } elseif ($summary -match '(?i)couldn''t access .+:') { 'PsExec cannot access target' } elseif ($summary -match '(?i)timed out|timeout') { 'Connection timed out' } elseif ($summary.Length -gt 72) { $summary.Substring(0, 69) + '...' } else { $summary } } }</ScriptBlock></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>WinPush.RunResult.Status</Name>
      <ViewSelectedBy>
        <TypeName>WinPush.RunResult</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>ComputerName</Label></TableColumnHeader>
          <TableColumnHeader><Label>Operation</Label></TableColumnHeader>
          <TableColumnHeader><Label>Status</Label></TableColumnHeader>
          <TableColumnHeader><Label>ExitCode</Label></TableColumnHeader>
          <TableColumnHeader><Label>TargetLog</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>ComputerName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Operation</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.Succeeded) { 'OK' } else { 'Failed' }</ScriptBlock></TableColumnItem>
              <TableColumnItem><PropertyName>ExitCode</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($_.TargetLogExists) { 'Available' } else { 'Missing' }</ScriptBlock></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>WinPush.RemediationValidationResult.Status</Name>
      <ViewSelectedBy>
        <TypeName>WinPush.RemediationValidationResult</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Valid</Label></TableColumnHeader>
          <TableColumnHeader><Label>Errors</Label></TableColumnHeader>
          <TableColumnHeader><Label>Warnings</Label></TableColumnHeader>
          <TableColumnHeader><Label>DetectScript</Label></TableColumnHeader>
          <TableColumnHeader><Label>RemediateScript</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>IsValid</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>@($_.Errors).Count</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>@($_.Warnings).Count</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>if (-not [string]::IsNullOrWhiteSpace($_.DetectScriptPath)) { [System.IO.Path]::GetFileName($_.DetectScriptPath) }</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>if (-not [string]::IsNullOrWhiteSpace($_.RemediateScriptPath)) { [System.IO.Path]::GetFileName($_.RemediateScriptPath) }</ScriptBlock></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>WinPush.ExecutionResult.RunRemediation.Status</Name>
      <ViewSelectedBy>
        <TypeName>WinPush.ExecutionResult.RunRemediation</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>ComputerName</Label></TableColumnHeader>
          <TableColumnHeader><Label>Transport</Label></TableColumnHeader>
          <TableColumnHeader><Label>Status</Label></TableColumnHeader>
          <TableColumnHeader><Label>DetectExit</Label></TableColumnHeader>
          <TableColumnHeader><Label>RemediateExit</Label></TableColumnHeader>
          <TableColumnHeader><Label>ErrorSummary</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>ComputerName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Transport</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($null -ne $_.RemediationMetadata) { $_.RemediationMetadata.Status } elseif ($_.Succeeded) { 'OK' } else { 'Failed' }</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($null -ne $_.RemediationMetadata) { $_.RemediationMetadata.DetectionExitCode }</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>if ($null -ne $_.RemediationMetadata) { $_.RemediationMetadata.RemediationExitCode }</ScriptBlock></TableColumnItem>
              <TableColumnItem><ScriptBlock>if (-not $_.Succeeded) { $message = if (-not [string]::IsNullOrWhiteSpace($_.ErrorMessage)) { [string] $_.ErrorMessage } elseif (@($_.Errors).Count -gt 0) { [string] @($_.Errors)[0] } else { $null }; if (-not [string]::IsNullOrWhiteSpace($message)) { $summary = $message -replace '\s+', ' '; if ($summary.Length -gt 72) { $summary.Substring(0, 69) + '...' } else { $summary } } }</ScriptBlock></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
