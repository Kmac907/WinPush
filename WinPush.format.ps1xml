<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>WinPush.ExecutionResult.Status</Name>
      <ViewSelectedBy>
        <TypeName>WinPush.ExecutionResult</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>ComputerName</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Status</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Operation</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>ExitCode</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Details</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Artifacts</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>ErrorSummary</Label>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <PropertyName>ComputerName</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>if ($_.Succeeded) { 'OK' } else { 'Failed' }</ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Operation</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>ExitCode</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>$result = $_; switch ($result.Operation) { 'RunPackage' { $metadata = $result.PackageMetadata; if ($null -ne $metadata) { $package = if (-not [string]::IsNullOrWhiteSpace($metadata.PackageSource)) { [System.IO.Path]::GetFileName(([string] $metadata.PackageSource).TrimEnd('\', '/')) }; if ([string]::IsNullOrWhiteSpace($package)) { $package = [string] $metadata.PackageSource }; $cleanup = if ($metadata.CleanupPolicy -eq 'Never') { 'Cleanup: Retained' } elseif ($metadata.CleanupSucceeded -eq $true) { 'Cleanup: Removed' } elseif ($metadata.CleanupSucceeded -eq $false) { 'Cleanup: Failed' } else { $null }; $logs = if ($metadata.LogsCopied -eq $true -or @($metadata.CopiedLogPaths).Count -gt 0) { 'Logs: Yes' } else { 'Logs: No' }; @($package, $cleanup, $logs) -ne $null -join '; ' } } 'CopyFile' { $copy = @($result.Output)[0]; if ($null -ne $copy -and -not [string]::IsNullOrWhiteSpace($copy.Direction)) { $name = if (-not [string]::IsNullOrWhiteSpace($copy.FileName)) { $copy.FileName } else { [System.IO.Path]::GetFileName(([string] $copy.Source).TrimEnd('\', '/')) }; if ([string]::IsNullOrWhiteSpace($name)) { $name = [string] $copy.Source }; '{0}: {1} -&gt; {2}' -f $copy.Direction, $name, $copy.Destination } } 'GetLogs' { $copied = @($result.CopiedLogPaths).Count; $logs = @($result.Logs).Count; if ($copied -gt 0) { '{0} log(s) copied' -f $copied } elseif ($logs -gt 0) { '{0} log result(s)' -f $logs } } 'TestTarget' { if ($result.Succeeded) { 'Session created' } else { 'Session failed' } } }</ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>if (-not [string]::IsNullOrWhiteSpace($_.ResultPath)) { 'Yes' }</ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>$message = if (-not [string]::IsNullOrWhiteSpace($_.ErrorMessage)) { [string] $_.ErrorMessage } elseif (@($_.Errors).Count -gt 0) { [string] @($_.Errors)[0] } else { $null }; if (-not [string]::IsNullOrWhiteSpace($message)) { $summary = $message -replace '\s+', ' '; if ($summary -match 'server name cannot be resolved') { 'Server name cannot be resolved' } elseif ($summary -match 'client cannot connect to the destination') { 'Client cannot connect to destination' } elseif ($summary -match '(?i)access is denied|access denied') { 'Access denied' } elseif ($summary -match 'WinRM cannot complete the operation') { 'WinRM cannot complete the operation' } elseif ($summary.Length -gt 100) { $summary.Substring(0, 97) + '...' } else { $summary } }</ScriptBlock>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
